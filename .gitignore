data/.demo_reset_done
data/.demo_lang_set

# Customer state — generated on first run by stores' load() seed logic.
# In this fork we keep them out of git to prevent accidental commits of
# production data. The relevant store modules re-create these files with
# seed defaults when missing.
data/rbac_users.json
data/org-settings.json
data/public-incidents.json
data/soa.json
data/risks.json
data/findings.json
data/assets.json
