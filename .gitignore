data/training.json
data/entities.json
data/org-units.json
data/policy-acks.json
data/policy-distributions.json
data/scan-import-state.json

# GDPR runtime records — VVT, DSAR, DSB, DPIA, breaches, TOMs.
# Highly sensitive customer data; never in repo.
data/gdpr/

# Uploaded binary files (not tracked in git)
data/template-files/
data/guidance/files/
data/bcm-files/
data/governance-files/
data/legal/

# SQLite database (generated from JSON seed on first run)
data/isms.db
